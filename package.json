{
  "name": "evolution-atlas",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "analyze": "node scripts/analyze.mjs",
    "analyze-commits": "node scripts/analyze-commits.mjs",
    "assign-capability-evidence": "node scripts/assign-capability-evidence.mjs",
    "build-capability-disagreements": "node scripts/build-capability-disagreements.mjs",
    "build-capability-hierarchy-review": "node scripts/build-capability-hierarchy-review.mjs",
    "capabilities": "node scripts/capabilities.mjs",
    "compare-capability-critics": "node scripts/compare-capability-critics.mjs",
    "compare-capability-hierarchy-critics": "node scripts/compare-capability-hierarchy-critics.mjs",
    "compare-capability-inductions": "node scripts/compare-capability-inductions.mjs",
    "critic-capability-disagreements": "node scripts/critic-capability-disagreements.mjs",
    "critic-capability-hierarchy": "node scripts/critic-capability-hierarchy.mjs",
    "critic-capability-hierarchy-staged": "node scripts/critic-capability-hierarchy-staged.mjs",
    "induce-capabilities": "node scripts/induce-capabilities.mjs",
    "discover-capability-graph": "node scripts/discover-capability-graph.mjs",
    "epochs": "node scripts/epochs.mjs",
    "survey": "node scripts/survey.mjs",
    "gallery": "node scripts/gallery.mjs",
    "interpret": "node scripts/interpret.mjs",
    "control:atlas": "node scripts/control-atlas.mjs",
    "dev": "vite",
    "verify:ui": "node scripts/control-atlas.mjs verify --all",
    "verify:ready": "node scripts/control-atlas.mjs doctor",
    "test": "GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 node scripts/test.mjs",
    "test:engine": "npm test -- test/experiment-status.test.mjs test/repository-engine.test.mjs test/repository-runtime.test.mjs test/repository-host.test.mjs test/repository-evolution.test.mjs test/repository-engine-contract.test.mjs test/repository-review-history.test.mjs test/repositoryMap.test.ts",
    "experiment:status": "node scripts/experiment-status.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:pstack": "node scripts/check-pstack.mjs",
    "check": "npm run check:pstack && npm test && npm run build && git diff --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "d3": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.64.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
